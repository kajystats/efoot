# ── EFOOT Backend — Variables d'environnement ──
# Copie ce fichier en .env et complète les valeurs
# NE JAMAIS COMMITER .env SUR GITHUB

NODE_ENV=production
PORT=3000

# ── Base PostgreSQL ───────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=efoot_db
DB_USER=ton_utilisateur
DB_PASSWORD=ton_mot_de_passe
# Ou DATABASE_URL directe (ex: Supabase) :
# DATABASE_URL=postgresql://user:pass@host:5432/db

# ── API-Football ───────────────────────────────
# Obtenir une clé gratuite sur : api-football.com
API_FOOTBALL_KEY=ta_cle_ici
API_FOOTBALL_HOST=v3.football.api-sports.io

# ── Sécurité ──────────────────────────────────
# Génère une chaîne aléatoire longue et unique
JWT_SECRET=change_moi_une_chaine_aleatoire_et_longue
CORS_ORIGIN=https://kajystats.github.io/efoot

# ── Fréquence de synchronisation ──────────────
# Format node-cron : min heure * * *
CRON_SYNC_MATCHES=0 */6 * * *
