NODE_ENV=production
PORT=3000

# Base PostgreSQL (Supabase ou local)
# DATABASE_URL=postgresql://user:pass@host:5432/db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=efoot_db
DB_USER=ton_utilisateur
DB_PASSWORD=ton_mot_de_passe

# API-Football → clé sur api-football.com
API_FOOTBALL_KEY=api-football.com
API_FOOTBALL_HOST=v3.football.api-sports.io

# Autorisation de ton site
CORS_ORIGIN=https://kajystats.github.io/efoot

# Fréquence synchro (toutes les 6h par défaut)
CRON_SYNC_MATCHES=0 */6 * * *
